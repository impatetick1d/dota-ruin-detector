{
  "name": "dota2-ruin-detector",
  "version": "1.0.0",
  "description": "Веб-сервис для автоматического поиска руинеров в матчах Dota 2 на базе OpenDota API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
